# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vscode secrets
.vscode/mcp.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# claude local settings
.claude/settings.local.json

# playwright session data
.playwright-mcp/

# debug screenshots (root-level test artifacts)
*.png
*.jpg
!public/**/*.png
!public/**/*.jpg
!src/**/*.png
!src/**/*.jpg
